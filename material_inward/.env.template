# ============================================================
# MATERIAL INWARD PROCESS — ENVIRONMENT CONFIGURATION
# 1. Copy this file: copy .env.template .env
# 2. Fill in every value marked with <...>
# 3. NEVER commit .env to version control
# ============================================================

# --- Flask Application ---
FLASK_SECRET_KEY=<generate-with: python -c "import secrets; print(secrets.token_hex(32))">
FLASK_ENV=production

# --- Server ---
# Dev: SERVER_HOST=127.0.0.1 (local only)
# Prod: SERVER_HOST=0.0.0.0 (accessible on network)
SERVER_HOST=127.0.0.1
SERVER_PORT=5000

# ============================================================
# ENVIRONMENT SWITCH — controls which app-root paths this install uses.
# true = production, false = development.
# Everything under the chosen root (robot_scripts, logs\rf_output,
# dms_staging, gst_screenshots, gst_edge_profile) keeps the SAME internal
# folder structure in both -- only the root itself changes. Missing
# folders are created automatically on first run/write.
# Does NOT affect DB_*, SAP_*, AD_*, or the robot_lock.py lock file --
# those stay single values, changed by hand.
# ============================================================
IS_PRODUCTION=true
PROD_APP_ROOT=<path to the production install, e.g. C:\material_inward>
DEV_APP_ROOT=<path to the dev install, e.g. C:\material_inward>

# Client production URL — whitelist this on your server firewall
# Example: ALLOWED_ORIGIN=https://materialinward.supremeind.com
ALLOWED_ORIGIN=https://REPLACE_WITH_CLIENT_PRODUCTION_URL_HERE

# --- JWT ---
JWT_SECRET_KEY=<generate-with: python -c "import secrets; print(secrets.token_hex(32))">
JWT_ALGORITHM=HS256

# --- PostgreSQL Database ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=material_inward
DB_USER=material_user
DB_PASSWORD=<your-db-password>

# --- SAP Credentials ---
# v16: SAP_USERNAME/SAP_PASSWORD below is the SHARED spl_rpa service
# account. Which bot uses this shared account vs. an individual LDAP
# user's own SAP login (captured in-memory at their app login, never
# written here or to any DB — see services/credential_cache.py) depends
# on the bot:
#
#   ALWAYS uses this shared spl_rpa account, for every user, no exceptions:
#     - po_fetch.robot        (ME23N — read-only PO line-item lookup)
#     - po_list_fetch.robot   (ME2N  — read-only open-PO-by-vendor lookup)
#     Reason: read-only lookups feeding MIGO's line items, not an
#     attributable posting. By explicit client decision.
#
#   Uses this shared account ONLY for auth_type='local' (test) users;
#   real LDAP users get their own SAP login instead, injected at runtime
#   as SAP_USER_OVERRIDE/SAP_PASS_OVERRIDE (deliberately never set as
#   real .env keys — see rf_runner.py's _sap_credential_env()):
#     - gate_in.robot, migo_103.robot, migo_105.robot, miro.robot,
#       zgatein_update.robot
#     Reason: these post real documents into SAP — the audit trail should
#     show the real person, not spl_rpa, for every posting.
SAP_LOGON_PATH=C:\Program Files\SAP\FrontEnd\SAPGUI\saplogon.exe
SAP_CONNECTION_NAME=SAP Production System
SAP_CLIENT=400
SAP_USERNAME=spl_rpa
SAP_PASSWORD=<sap-rpa-password>

# --- Active Directory / LDAP (login) ---
AD_SERVER=<ad-server-ip>
AD_DOMAIN=<ad-domain, e.g. spl.com>

# --- Outlook Email (SMTP for sending + IMAP for receiving) — prod/dev pair ---
# Follows IS_PRODUCTION like everything else above.
PROD_SMTP_SERVER=smtp.office365.com
PROD_SMTP_PORT=587
PROD_EMAIL_SENDER=spl_rpa@company.com
PROD_EMAIL_PASSWORD=<email-password>
PROD_IMAP_SERVER=outlook.office365.com
PROD_IMAP_PORT=993
PROD_IMAP_USERNAME=spl_rpa@company.com
PROD_IMAP_PASSWORD=<email-password>

DEV_SMTP_SERVER=smtp.office365.com
DEV_SMTP_PORT=587
DEV_EMAIL_SENDER=
DEV_EMAIL_PASSWORD=
DEV_IMAP_SERVER=outlook.office365.com
DEV_IMAP_PORT=993
DEV_IMAP_USERNAME=
DEV_IMAP_PASSWORD=

IMAP_POLL_FOLDER=INBOX

# --- Notification Recipients (fill when available) ---
GATEIN_OWNER_EMAIL=
MIGO_OWNER_EMAIL=
MIRO_OWNER_EMAIL=

# --- WatsonX AI (OCR) ---
WATSONX_API_KEY=<your-watsonx-api-key>
WATSONX_PROJECT_ID=<your-project-id>
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=meta-llama/llama-4-maverick-17b-128e-instruct-fp8

# --- Robot Framework ---
# RF_SCRIPTS_PATH / RF_OUTPUT_PATH are derived automatically from
# PROD_APP_ROOT/DEV_APP_ROOT + IS_PRODUCTION above (config.py) -- no
# longer set explicitly here.

# --- File Upload ---
UPLOAD_FOLDER=uploads
# DMS_STAGING_FOLDER / DMS_LINKS_EXCEL_PATH are also derived from
# PROD_APP_ROOT/DEV_APP_ROOT + IS_PRODUCTION above -- no longer set here.
MAX_FILE_SIZE_MB=50

# --- Contentverse DMS Portal (dms_upload.robot) ---
CV_USERNAME=<contentverse-login-username>
CV_PASSWORD=<contentverse-login-password>

# --- Document Attachment Name Keywords ---
# Edit these if the plant team changes their file naming convention
INVOICE_KEYWORD=invoice
EWAYBILL_KEYWORD=eway
LR_KEYWORD=lr
OTHERS_KEYWORD=oth

# --- Phase Rollout: Enabled Workflow Tabs ---
# FIX: code checks each step individually (config.is_step_enabled()) using
# the granular names "migo_103"/"migo_105" -- a plain "migo" here matches
# neither, so following the old example literally silently disabled both
# MIGO tabs. Corrected below to the actual step names.
# Phase 1 (Gate In only): ENABLED_STEPS=gate_in
# Phase 2 (Gate In + MIGO): ENABLED_STEPS=gate_in,migo_103,migo_105
# All phases: ENABLED_STEPS=gate_in,migo_103,migo_105,miro,gst
ENABLED_STEPS=gate_in,migo_103,migo_105,miro,gst


